From c2f62cd5f043ac9d827dedd5e0bd5f69e01e3e98 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 10 Sep 2026 17:11:36 +0000
Subject: [PATCH 1/2] FileStream.write: refresh the read cache after writing
 changed data

read() caches file bytes in this.packed; write() read the old bytes first
and never replaced them, so packClientVersionList computed the previous
build's crc for every changed map/model/anim. Clients then kept their stale
cached copy (or rejected the new file) - the Warriors' Guild map showed as
the old Burthorpe grass.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WTo3qFuhgbaA3yymZcTW7m
---
 src/io/FileStream.ts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/io/FileStream.ts b/src/io/FileStream.ts
index 5a3767b..26a1b87 100644
--- a/src/io/FileStream.ts
+++ b/src/io/FileStream.ts
@@ -211,6 +211,16 @@ export default class FileStream {
             sector = nextSector;
         }
 
+        // read() above cached the OLD bytes in this.packed; replace them so later reads in the same
+        // process (packClientVersionList's crc pass) see what is now on disk. Without this every
+        // changed map/model got the previous build's crc in the versionlist, so clients kept their
+        // old cached copy (or, with nothing cached, rejected the new file forever).
+        if (this.discardPacked) {
+            delete this.packed[archive][file];
+        } else {
+            this.packed[archive][file] = data;
+        }
+
         return true;
     }
 
-- 
2.43.0


